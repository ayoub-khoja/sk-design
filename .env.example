# Copiez ce fichier en .env.local et remplissez les valeurs (voir docs/mongodb.md)

# Site local
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MongoDB Atlas — chaîne de connexion (Connect → Drivers)
MONGODB_URI=
MONGODB_DB=skdesign

# Clé secrète des sessions admin (longue chaîne aléatoire, ne jamais la partager)
SESSION_SECRET=

# Compte admin créé par scripts/seed.mjs
ADMIN_EMAIL=
ADMIN_PASSWORD=
